# Web3Forms access key for the contact form.
# Get a free key (no account needed) at https://web3forms.com; it is emailed to you.
#
# Local development:  copy this file to .env.local and fill in the key.
# Vercel deployment:  set WEB3FORMS_KEY under
#                     Project Settings > Environment Variables, then redeploy.
#
# Either name works: vite.config.js allows the VITE_ and WEB3FORMS_ prefixes
# through, so .env.local can use either one.
#
# Note: Vite inlines these into the client bundle at build time. That is
# expected here, since a Web3Forms access key is a public, submit-only key.
WEB3FORMS_KEY=your-access-key-here
